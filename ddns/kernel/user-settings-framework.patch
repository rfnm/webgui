+	for(i = 0; i < width; i++) {
+		if((val >> i) & 1) {
+			payload[(off + i) / 8] |= 1 << ((off + i) % 8);
+		} else {
+			payload[(off + i) / 8] &= ~(1 << ((off + i) % 8));
+		}
+	}
