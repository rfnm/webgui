+static uint32_t rfnm_user_bits_get(const uint8_t *payload, uint16_t off, uint16_t width) {
+
+	uint32_t v = 0;
+	int i;
+
+	for(i = 0; i < width; i++) {
+		v |= (uint32_t)((payload[(off + i) / 8] >> ((off + i) % 8)) & 1) << i;
+	}
+
